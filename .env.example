# Public address of the site (used for OAuth callbacks and CSRF checks).
ORIGIN=https://bitlin.dev
CANONICAL_ORIGIN=https://bitlin.dev
NODE_ENV=production

# 32+ random characters: openssl rand -base64 48
SECRET_KEY=

POSTGRES_PASSWORD=
REDIS_PASSWORD=
MINIO_ROOT_USER=bitlin
MINIO_ROOT_PASSWORD=

# Cloudflare Tunnel token (Zero Trust > Networks > Tunnels)
TUNNEL_TOKEN=

# OAuth apps; callback URL is ORIGIN/auth/<provider>/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Optional limits
MAX_FILE_MB=25
MAX_FILES=5000
MAX_UPLOAD_MB=60
MAX_UNZIP_MB=150
